<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/colorBackground">

    <!-- Top Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/colorPrimary"
        android:padding="20dp"
        android:gravity="center_vertical">
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="FRP Accounts Manager"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@color/white"/>
    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- Add FRP Record Card -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="16dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Add Device FRP Details"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:textSize="18sp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etFrpImei"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Device IMEI Number"
                        android:inputType="text"
                        android:background="@color/colorBackground"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etFrpEmail"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Google Email (FRP ID)"
                        android:inputType="textEmailAddress"
                        android:background="@color/colorBackground"
                        android:padding="12dp"
                        android:layout_marginBottom="12dp"/>

                    <EditText
                        android:id="@+id/etFrpPassword"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:hint="Google Account Password"
                        android:inputType="textPassword"
                        android:background="@color/colorBackground"
                        android:padding="12dp"
                        android:layout_marginBottom="16dp"/>

                    <Button
                        android:id="@+id/btnSaveFrp"
                        android:layout_width="match_parent"
                        android:layout_height="50dp"
                        android:text="Save FRP Details"
                        android:backgroundTint="@color/colorPrimary"
                        android:textColor="@color/white"/>

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Saved FRP List Section -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Saved FRP Records"
                android:textStyle="bold"
                android:textColor="@color/colorPrimary"
                android:textSize="18sp"
                android:layout_marginTop="8dp"
                android:layout_marginBottom="12dp"/>

            <!-- Sample Saved Card (FireBase से डायनामिक आएगा) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="12dp"
                app:cardElevation="2dp">
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@color/white"
                    android:padding="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="IMEI: 8645XXXXXXXX901"
                        android:textStyle="bold"
                        android:textColor="@color/colorPrimary"
                        android:textSize="16sp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Email: customer.sample@gmail.com"
                        android:textColor="@color/colorTextPrimary"
                        android:layout_marginTop="4dp"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password: ••••••••"
                        android:textColor="@color/colorTextSecondary"
                        android:layout_marginTop="2dp"/>
                </LinearLayout>
            </androidx.cardview.widget.CardView>

        </LinearLayout>
    </ScrollView>
</LinearLayout>
