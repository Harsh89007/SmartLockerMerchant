<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Edit Customer Profile"
            android:textSize="18sp"
            android:textStyle="bold"
            android:textColor="#0F2445"
            android:layout_marginBottom="12dp"/>

        <androidx.cardview.widget.CardView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="20dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="2dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp"
                android:background="#FFFFFF">

                <EditText
                    android:id="@+id/etCustomerName"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Customer Name"
                    android:background="#F5F5F5"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etCustomerMobile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Mobile Number"
                    android:inputType="phone"
                    android:background="#F5F5F5"
                    android:padding="10dp"
                    android:layout_marginBottom="8dp"/>

                <EditText
                    android:id="@+id/etCustomerEmail"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:hint="Email ID"
                    android:inputType="textEmailAddress"
                    android:background="#F5F5F5"
                    android:padding="10dp"
                    android:layout_marginBottom="12dp"/>

                <Button
                    android:id="@+id/btnSaveProfile"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:text="Save Details"
                    android:backgroundTint="#4CAF50"
                    android:textColor="#FFFFFF"/>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advance Controls"
            android:textStyle="bold"
            android:textColor="#0F2445"
            android:textSize="18sp"
            android:layout_marginBottom="12dp"/>

        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins">

            <LinearLayout
                android:id="@+id/btnControlLock"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <FrameLayout
                    android:layout_width="65dp"
                    android:layout_height="65dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_control_box"
                        android:padding="16dp"
                        android:src="@android:drawable/ic_lock_idle_lock"
                        app:tint="#0F2445"/>

                    <TextView
                        android:id="@+id/badgeLock"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textSize="10sp"
                        android:textColor="#FFF"
                        android:background="#F44336"
                        android:layout_gravity="top|end"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="2dp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Lock"
                    android:textSize="12sp"
                    android:textColor="#0F2445"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnControlYoutube"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <FrameLayout
                    android:layout_width="65dp"
                    android:layout_height="65dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_control_box"
                        android:padding="16dp"
                        android:src="@android:drawable/ic_menu_slideshow"
                        app:tint="#0F2445"/>

                    <TextView
                        android:id="@+id/badgeYoutube"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textSize="10sp"
                        android:textColor="#FFF"
                        android:background="#F44336"
                        android:layout_gravity="top|end"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="2dp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="YouTube"
                    android:textSize="12sp"
                    android:textColor="#0F2445"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/btnControlCamera"
                android:orientation="vertical"
                android:gravity="center"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_columnWeight="1"
                android:layout_margin="8dp">

                <FrameLayout
                    android:layout_width="65dp"
                    android:layout_height="65dp">

                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/bg_control_box"
                        android:padding="16dp"
                        android:src="@android:drawable/ic_menu_camera"
                        app:tint="#0F2445"/>

                    <TextView
                        android:id="@+id/badgeCamera"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="OFF"
                        android:textSize="10sp"
                        android:textColor="#FFF"
                        android:background="#F44336"
                        android:layout_gravity="top|end"
                        android:paddingHorizontal="5dp"
                        android:paddingVertical="2dp"/>
                </FrameLayout>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Camera"
                    android:textSize="12sp"
                    android:textColor="#0F2445"
                    android:textStyle="bold"
                    android:layout_marginTop="6dp"/>
            </LinearLayout>

        </GridLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="40dp"/>

        <Button
            android:id="@+id/btnUninstallSystem"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Uninstall Client App"
            android:backgroundTint="#0F2445"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <Button
            android:id="@+id/btnRemoveProfile"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="Remove From Customer List"
            android:backgroundTint="#D32F2F"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="24dp"/>

    </LinearLayout>
</ScrollView>
