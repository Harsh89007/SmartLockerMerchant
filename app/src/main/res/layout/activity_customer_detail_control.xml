<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F8F9FA"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Advance Controls"
            android:textStyle="bold"
            android:textColor="#1A237E"
            android:textSize="18sp"
            android:layout_marginBottom="16dp"/>

        <!-- 3-Column Grid for Controls -->
        <GridLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:columnCount="3"
            android:alignmentMode="alignMargins">

            <!-- Item 1: Device Lock -->
            <LinearLayout android:id="@+id/btnControlLock" android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp">
                <FrameLayout android:layout_width="65dp" android:layout_height="65dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_control_box" android:padding="16dp" android:src="@android:drawable/ic_lock_idle_lock" android:tint="#1A237E"/>
                    <TextView android:id="@+id/badgeLock" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="OFF" android:textSize="10sp" android:textColor="#FFF" android:background="#F44336" android:layout_gravity="top|end" android:layout_marginTop="-2dp" android:layout_marginEnd="-2dp" android:paddingHorizontal="5dp" android:paddingVertical="2dp"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lock" android:textSize="13sp" android:textColor="#1A237E" android:textStyle="bold" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Item 2: YouTube Lock -->
            <LinearLayout android:id="@+id/btnControlYoutube" android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp">
                <FrameLayout android:layout_width="65dp" android:layout_height="65dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_control_box" android:padding="16dp" android:src="@android:drawable/ic_menu_slideshow" android:tint="#1A237E"/>
                    <TextView android:id="@+id/badgeYoutube" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ON" android:textSize="10sp" android:textColor="#FFF" android:background="@drawable/bg_badge_on" android:layout_gravity="top|end" android:layout_marginTop="-2dp" android:layout_marginEnd="-2dp" android:paddingHorizontal="5dp" android:paddingVertical="2dp"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="YouTube" android:textSize="13sp" android:textColor="#1A237E" android:textStyle="bold" android:layout_marginTop="6dp"/>
            </LinearLayout>

            <!-- Item 3: Camera Lock -->
            <LinearLayout android:id="@+id/btnControlCamera" android:orientation="vertical" android:gravity="center" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_columnWeight="1" android:layout_margin="8dp">
                <FrameLayout android:layout_width="65dp" android:layout_height="65dp">
                    <ImageView android:layout_width="match_parent" android:layout_height="match_parent" android:background="@drawable/bg_control_box" android:padding="16dp" android:src="@android:drawable/ic_menu_camera" android:tint="#1A237E"/>
                    <TextView android:id="@+id/badgeCamera" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="ON" android:textSize="10sp" android:textColor="#FFF" android:background="@drawable/bg_badge_on" android:layout_gravity="top|end" android:layout_marginTop="-2dp" android:layout_marginEnd="-2dp" android:paddingHorizontal="5dp" android:paddingVertical="2dp"/>
                </FrameLayout>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Camera" android:textSize="13sp" android:textColor="#1A237E" android:textStyle="bold" android:layout_marginTop="6dp"/>
            </LinearLayout>

        </GridLayout>

        <!-- Spacer -->
        <View android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" android:minHeight="50dp"/>

        <!-- UNINSTALL BUTTON -->
        <Button
            android:id="@+id/btnUninstallSystem"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Uninstall"
            android:backgroundTint="#0F2445"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:layout_marginBottom="12dp"/>

        <!-- REMOVE PROFILE BUTTON (छुपा रहेगा, अनइंस्टॉल के बाद दिखेगा) -->
        <Button
            android:id="@+id/btnRemoveProfile"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Remove From Customer List"
            android:backgroundTint="#D32F2F"
            android:textColor="@color/white"
            android:textSize="16sp"
            android:textStyle="bold"
            android:visibility="gone"
            android:layout_marginBottom="30dp"/>

    </LinearLayout>
</ScrollView>

